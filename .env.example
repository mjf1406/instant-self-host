# Public URLs. These must match the Cloudflare Tunnel hostnames.
INSTANT_BACKEND_URL=https://api.example.com
INSTANT_DASHBOARD_URL=https://dash.example.com
S3_PUBLIC_ENDPOINT=https://files.example.com

# Cloudflare Tunnel token (the long eyJ... string from the install command).
# Not the Tunnel ID. See README section 2. Do not run the install command on the host.
TUNNEL_TOKEN=replace-with-your-tunnel-token

# Database. Replace the password before deploying.
POSTGRES_USER=instant
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=instant
CONNECTION_POOL_SIZE=20

# Object storage. Replace these before deploying.
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=instant-bucket
S3_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1

# JVM heap. Leave 2 GB+ for the OS and other containers on a 4 GB host.
JAVA_OPTS=-Xmx2g -Xms2g

# Dashboard admin. Instant creates this user on first start.
INSTANT_SUPERUSER_EMAIL=admin@example.com

# Google OAuth for dashboard login.
# Authorized redirect URI: https://api.example.com/dash/oauth/callback
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Cloudflare R2 backups. Use a dedicated bucket and a token limited to that bucket.
# Losing RESTIC_PASSWORD makes recovery impossible. Store it in a password manager.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=instant-self-host-backups
# Leave empty for https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# If you set this, use the account-level endpoint only. Never include the bucket name.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REGION=auto
RESTIC_PASSWORD=replace-with-a-long-random-restic-password
# Leave both empty unless you need a custom restic URL.
# RESTIC_REPOSITORY_PREFIX is an extra path inside the bucket. Do not set it to the bucket name.
RESTIC_REPOSITORY=
RESTIC_REPOSITORY_PREFIX=

# Schedule and health. Times are UTC.
# Default: one snapshot every 6 hours. Change BACKUP_CRON if you want a different interval.
BACKUP_CRON=0 */6 * * *
BACKUP_FRESHNESS_SECONDS=28800
BACKUP_MAX_RUNTIME_SECONDS=7200
BACKUP_MIN_FREE_MB=1024
# Default staging is the backup_staging Docker volume on the root disk.
BACKUP_STAGING_SOURCE=

# Retention. Keep every snapshot for 7 days, then 5 weekly and 12 monthly copies.
# RESTIC_KEEP_WITHIN must stay at least as long as the 7-day R2 bucket lock.
RESTIC_KEEP_WITHIN=7d
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
RESTIC_CHECK_READ_DATA_SUBSET=5%
MAINTENANCE_WEEKDAY=0

# First-time repository create. Leave this empty in Portainer.
# Pass yes only on the one-off init command. See README section 9.6.
RESTIC_INIT_CONFIRM=

# Restore helper. Leave these empty in Portainer.
# Pass them only on a one-off drill or live restore command. See README section 9.8.
RESTORE_SNAPSHOT=latest
RESTORE_TARGET_DB=
RESTORE_TARGET_BUCKET=
RESTORE_CONFIG_DIR=
RESTORE_CLEANUP=
RESTORE_CONFIRM=
