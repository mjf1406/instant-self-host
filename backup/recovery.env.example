# Clean-host recovery. Copy to recovery.env and keep that file off git.
# R2 objects are encrypted. Recovery also needs RESTIC_PASSWORD.
# If RESTIC_PASSWORD is lost, the repository cannot be opened.

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=instant-self-host-backups
# Leave empty for https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# If you set this, use the account-level endpoint only. Never include the bucket name.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REGION=auto
RESTIC_PASSWORD=replace-with-a-long-random-restic-password
# Leave both empty unless the production stack used a custom restic URL.
RESTIC_REPOSITORY=
RESTIC_REPOSITORY_PREFIX=

# Host directory that receives Instant restore ZIPs.
RECOVERY_EXPORT_DIR=./exports
